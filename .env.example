# Public feature switch only, NEVER put AWS credentials or provider tokens in VITE_*.
# Start `npm run dev:api` in another terminal before enabling this local experiment.
VITE_ENABLE_INSTAGRAM_PREVIEW=false
# Server-only settings for CLI/dev API (shell environment, not Vite client settings):
# AWS_REGION=us-east-1
# PINWISH_BEDROCK_MODEL=qwen.qwen3-vl-235b-a22b

# PINWISH_PLACES_REGION=us-east-1
# PINWISH_QUERY_MODEL=qwen.qwen3-vl-235b-a22b

# Public identifiers from `npm run cloud:configure` (not AWS secret credentials).
# When all three are set, the UI uses real accounts and cloud storage.
# VITE_AWS_REGION=us-east-1
# VITE_COGNITO_CLIENT_ID=
# VITE_STORAGE_API_URL=
