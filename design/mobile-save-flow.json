  "layout": {
    "reference": {
      "width": 390,
      "height": 884
    },
    "viewport": "100dvh; do not hardcode 884px in production",
    "header": 64,
    "horizontalPadding": 16,
    "gap": 12,
    "primaryButtonHeight": 48,
    "minHitTarget": 44,
    "footer": "Pinned after flex:1 scroll body; pad bottom by max(16px, env(safe-area-inset-bottom)). Keep form visible above mobile keyboard.",
    "body": "min-height:0; overflow-y:auto; keep header and action footer outside body scrolling",
    "width": "Fluid from 320px through mobile widths; fields width:100%; at desktop reuse existing 440px save dialog",
    "breakpoints": "Suggested implementation breakpoint 768px for mobile/full-screen vs desktop dialog; validate against actual host layout before shipping",
    "fonts": "Inter; reuse src/styles/tokens.css and Figma styles; editable text, not screenshots",
    "map": "Illustrative preview only; replace with actual map provider. All pins remain independent UI."
  },
  "draft": {
    "fields": [
      "originalInput",
      "inputMode: link | address",
      "resolvedPlaceId",
      "displayName",
      "formattedAddress",
      "latitude",
      "longitude",
      "note",
      "collectionId",
      "originView: list | map",
      "idempotencyKey"
    ],
    "persistence": "Keep draft in memory during screen changes and network failures; never clear until save confirmed or user explicitly discards. Do not persist private notes to storage by default.",
    "noteMaxLength": 1000,
    "inputMaxLength": 2048,
    "collection": "Required. Default to originating collection, or first available collection. Use native select/dialog populated from actual collections; Change does not create collections.",
    "source": "Keep original social link when manual address lookup is used; never replace origin URL with generated text."
  },
  "states": {
    "entry": {
      "primary": "Find place",
      "behavior": "Validate on submit. Empty or malformed input -> invalid. Valid link/address -> resolving. Paste only on explicit click; clipboard denied/unavailable leaves manual input usable with inline feedback."
    },
    "resolving": {
      "primaryDisabled": true,
      "fieldsReadOnly": true,
      "busy": true,
      "onResolved": "ready",
      "onNoLocation": "not_found",
      "onFailure": "lookup_error",
      "onCancel": "entry",
      "timeoutMs": 15000,
      "behavior": "Abort lookup on cancel or edit; ignore stale responses using request identity. Never save automatically."
    },
    "ready": {
      "primary": "Save place",
      "enabledWhen": "Resolved place with coordinates AND selected collection",
      "onSubmit": "saving",
      "changeLocation": "not_found in manual-address mode; preserve original link and note",
      "behavior": "Use user confirmation to save; UI does not imply every social post can be parsed."
    },
    "invalid": {
      "alert": true,
      "onEdit": "entry with previous input retained",
      "onValidSubmit": "resolving",
      "behavior": "Field aria-invalid=true, error linked via aria-describedby. Focus input after failed submit."
    },
    "not_found": {
      "alert": true,
      "mode": "address",
      "onSubmit": "resolving",
      "onEditOriginal": "entry",
      "behavior": "Do not invent coordinates. Show candidate selection when provider returns multiple results; confirm candidate before ready. Existing frame illustrates manual fallback."
    },
    "lookup_error": {
      "alert": true,
      "onRetry": "resolving",
      "onEditOriginal": "entry",
      "behavior": "Network error is not invalid input; do not mark input aria-invalid."
    },
    "saving": {
      "primaryDisabled": true,
      "fieldsReadOnly": true,
      "busy": true,
      "onConfirmed": "success",
      "onAlreadySaved": "duplicate",
      "onFailure": "save_error",
      "timeoutMs": 15000,
      "behavior": "Disable duplicate submissions and change-location/collection while pending. Use a bounded request; never leave UI indefinitely busy. Back control disabled for this bounded pending operation. Reuse idempotency key on uncertain retry."
    },
    "save_error": {
      "alert": true,
      "onRetry": "saving",
      "behavior": "Keep all draft values. Network/timeouts do not mean original link is invalid. Retry with original idempotency key; server returns prior confirmed result if it already saved."
    },
    "duplicate": {
      "primary": "View saved place",
      "target": "Existing saved record, not a new duplicate",
      "behavior": "Detected by stable place identity within collection; do not overwrite existing note silently. Existing draft can be recovered by back."
    },
    "success": {
      "primary": "View place",
      "secondary": "Back to map",
      "behavior": "Only after server acknowledgement. Update list/map cache from saved record, not arbitrary +1. Clear confirmed draft. Return to saved place details or centered map."
    },
    "list_loading": {
      "busy": true,
      "onSuccess": "existing mobile list 1:106",
      "onFailure": "list_error",
      "behavior": "Skeletons are aria-hidden; announce Loading your saved places with role=status. If cached records exist, retain them and show a small refresh indicator instead of skeletons."
    },
    "list_error": {
      "alert": true,
      "onRetry": "list_loading",
      "secondary": "existing mobile map 1:2",
      "behavior": "Never show fake empty collection on fetch failure; cached places remain available if present."
    }
  },
